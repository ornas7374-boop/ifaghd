# Copy this file to .env.local (in this dashboard/ directory) and fill in real values.
# Next.js only reads .env* files from this directory, not the repo root.

# Postgres connection string used directly by the dashboard (same DB the n8n workflows use).
DATABASE_URL=postgresql://user:password@host:5432/database
# Set to "false" only if your Postgres does not require SSL (e.g. local dev).
DATABASE_SSL=true

# Base URL of your n8n instance (no trailing slash, no /webhook suffix).
# e.g. https://your-instance.app.n8n.cloud
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com

      "id": "3210b383-3d44-56fb-99eb-fb7bf076a695",
      "name": "Respond 200 (ACK)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        -80,
        140
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Turn the agent's handoff payload into what a human on shift needs to see.\n// Phone numbers are masked here because chat history is widely readable —\n// the unmasked number stays in the database for whoever claims the ticket.\nconst e = $input.first().json.body ?? $input.first().json;\n\nconst REASONS = {\n  customer_request: 'العميل طلب موظف',\n  angry_customer: 'العميل منزعج',\n  sensitive_issue: 'موضوع حساس',\n  low_confidence: 'الوكيل غير متأكد من الإجابة',\n  tool_failure: 'فشل في جلب البيانات',\n  missing_information: 'المعلومة غير متوفرة',\n  repeated_failure: 'تكرار عدم الحل',\n  policy_violation: 'مخالفة سياسة',\n  manual: 'تصعيد يدوي',\n};\n\nconst mask = (p) => {\n  const d = String(p ?? '').replace(/\\D/g, '');\n  return d.length <= 4 ? '****' : '*'.repeat(d.length - 4) + d.slice(-4);\n};\n\nconst priority = e.priority ?? 'normal';\nconst flag = priority === 'urgent' ? '🔴' : priority === 'high' ? '🟠' : '🟡';\n\nconst lines = [\n  `${flag} *تصعيد جديد* — ${e.tenant?.name ?? 'المتجر'}`,\n  `الأولوية: ${priority}`,\n  `العميل: ${e.customer?.name ?? 'غير معروف'} (${mask(e.customer?.phone ?? e.customer_phone)})`,\n  `السبب: ${REASONS[e.reason_code] ?? e.reason_code}`,\n  e.reason_detail ? `التفاصيل: ${e.reason_detail}` : null,\n  e.last_customer_message ? `آخر رسالة: ${e.last_customer_message}` : null,\n  e.conversation_summary ? `الملخص: ${e.conversation_summary}` : null,\n  `المحادثة: ${e.conversation_id}`,\n  `الوقت: ${new Date().toISOString()}`,\n].filter(Boolean);\n\nreturn [{\n  json: {\n    handoff_id: e.handoff_id,\n    tenant_id: e.tenant?.id ?? e.tenant_id,\n    priority,\n    is_urgent: priority === 'urgent' || priority === 'high',\n    text: lines.join('\\n'),\n    raw: e,\n  },\n}];\n"
      },
      "id": "15dfb0c5-ec6a-5b01-9689-ecb1b24b2cff",
      "name": "Format Escalation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        140,

          "conditions": [
            {
              "id": "a0b1a9d4-e4b4-5ed1-915d-cca1f59f2b4d",
              "leftValue": "={{ $json.is_urgent }}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": ""
            }
          ],

    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// The escalation row already exists in Postgres before this workflow runs, so\n// a failure here never loses the ticket — it only loses the notification, and\n// the ticket still shows up in v_pending_handoffs for whoever is on shift.\nconsole.log(JSON.stringify({\n  handoff_id: $('Format Escalation').item.json.handoff_id,\n  priority: $('Format Escalation').item.json.priority,\n  notified_at: new Date().toISOString(),\n}));\nreturn $input.all();\n"
      },

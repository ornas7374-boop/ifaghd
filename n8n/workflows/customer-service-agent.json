    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Choose what actually gets sent to the customer, per branch:\n//   - escalation branch -> the wording returned by Create Handoff\n//     (Notify Employee sits between, and its response is the notifier's, not ours)\n//   - agent branch      -> the generated reply\n// The agent can also escalate inside its own turn; handed_off carries that\n// through so downstream logging stays accurate.\nconst viaHandoff = $('Create Handoff').isExecuted;\nconst source = viaHandoff\n  ? $('Create Handoff').item.json\n  : $input.first().json;\n\nconst reply = viaHandoff ? source.customer_message : source.reply;\n\nif (!reply) {\n  throw new Error('No reply text produced — refusing to send an empty message');\n}\n\nreturn [{\n  json: {\n    reply,\n    handed_off: viaHandoff || source.handed_off === true,\n    intent: source.intent ?? $('Classify Intent').item.json.intent,\n    handoff_id: source.handoff_id ?? null,\n  },\n}];\n"
      },

      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Anything that reaches here means the customer has NOT been answered.\n// Escalating is the only correct outcome — never leave the message unhandled.\nconst ctx = $('Get Message Text').item.json;\nconst err = $input.first().json.error ?? $input.first().json;\n\nreturn [{\n  json: {\n    tenant_id: ctx.tenant_id,\n    conversation_id: ctx.conversation_id,\n    customer_id: ctx.customer_id,\n    reason_code: 'tool_failure',\n    reason_detail: `فشل في n8n: ${typeof err === 'string' ? err : JSON.stringify(err).slice(0, 300)}`,\n    priority: 'high',\n    last_customer_message: ctx.text,\n  },\n}];\n"
      },

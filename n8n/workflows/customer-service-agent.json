    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Validate Request\n// Accepts either shape:\n//   A) the agent service forwarded a normalized message:  { message: {...}, trace_id }\n//   B) Meta posted its raw webhook payload directly:      { object, entry: [...] }\n// Shape B is normalized one node later by the agent's own parser, so n8n and\n// the service never disagree about how a payload is read.\nconst out = [];\n\nfor (const item of $input.all()) {\n  const body = item.json.body ?? item.json;\n\n  if (body && body.message && body.message.external_message_id) {\n    out.push({ json: { shape: 'normalized', message: body.message, trace_id: body.trace_id ?? $execution.id } });\n    continue;\n  }\n\n  if (body && Array.isArray(body.entry)) {\n    out.push({ json: { shape: 'raw_meta', payload: body, trace_id: $execution.id } });\n    continue;\n  }\n\n  // Anything else is not a message we can act on. Emitting nothing here is\n  // deliberate: the webhook has already ACKed, and retrying a malformed body\n  // would never succeed.\n  console.log('Ignoring unrecognised webhook payload');\n}\n\nreturn out;\n"
      },

# =====================================================================
# ifaghd — AI Customer Service Agent
# Copy to .env and fill in. Never commit .env (it is git-ignored).
# =====================================================================

# ---- Runtime ---------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Public HTTPS URL of this service (what you register with Meta).
PUBLIC_BASE_URL=https://agent.your-domain.com
# Set false if the service is NOT behind a reverse proxy / load balancer.
TRUST_PROXY=true

# ---- Database (required) ---------------------------------------------
DATABASE_URL=postgresql://ifaghd:CHANGE_ME@localhost:5432/ifaghd
# Enable for managed Postgres (RDS, Supabase, Neon, ...).
DATABASE_SSL=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000

# ---- LLM (required) ---------------------------------------------------
# anthropic | openai | mock   ("mock" is for tests only — never production)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
# Optional: model to try once if the primary fails.
LLM_FALLBACK_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_MS=25000
LLM_MAX_RETRIES=2

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- WhatsApp Cloud API ----------------------------------------------
# Any string you choose; you type the same value into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_random_string
# Meta App Dashboard -> App Settings -> Basic -> App Secret.
# Used to verify the X-Hub-Signature-256 header on every webhook.
WHATSAPP_APP_SECRET=
# Meta App Dashboard -> WhatsApp -> API Setup -> Permanent access token.
WHATSAPP_ACCESS_TOKEN=
# Meta App Dashboard -> WhatsApp -> API Setup -> Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_TIMEOUT_MS=15000
# Keep true in production. The config schema refuses to boot with
# NODE_ENV=production + REQUIRE_SIGNATURE=true + no APP_SECRET.
WHATSAPP_REQUIRE_SIGNATURE=true

# ---- Internal API (required) -----------------------------------------
# Shared secret for /internal/v1/* — this is what n8n authenticates with.
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME_at_least_16_chars
# true  = the webhook only normalises + dedupes, then forwards to n8n,
#         and n8n drives every step through the internal API.
# false = this service answers the customer by itself (n8n optional).
WEBHOOK_DELEGATE_TO_N8N=false
N8N_INBOUND_WEBHOOK_URL=https://n8n.your-domain.com/webhook/whatsapp-inbound

# ---- Human handoff notification --------------------------------------
# none | webhook | slack | whatsapp
HANDOFF_NOTIFY_CHANNEL=none
HANDOFF_WEBHOOK_URL=
HANDOFF_SLACK_WEBHOOK_URL=
# E.164 without '+', e.g. 966500000000
HANDOFF_WHATSAPP_TO=

# ---- Agent behaviour --------------------------------------------------
# Raw turns sent to the model. Older turns are covered by the summary.
AGENT_HISTORY_LIMIT=10
# Fold history into the rolling summary every N new messages.
AGENT_SUMMARY_EVERY=12
# Max tool round-trips per customer message before escalating.
AGENT_MAX_TOOL_ITERATIONS=4
AGENT_MAX_REPLY_CHARS=900

# ---- Security / abuse -------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=120

# ---- n8n MCP (developer tooling only, not needed at runtime) ----------
N8N_API_URL=
N8N_API_KEY=

# ---- docker compose only ---------------------------------------------
POSTGRES_USER=ifaghd
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ifaghd
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
ONCALL_WEBHOOK_URL=
SUPPORT_WEBHOOK_URL=
HELPDESK_WEBHOOK_URL=

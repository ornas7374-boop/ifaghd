# Personal Sales Automation System — environment variables
# Copy this file and fill in real values. Never commit the filled-in version.
# The Next.js dashboard reads its own copy from dashboard/.env.local (see dashboard/.env.example) —
# this root file documents every credential the system as a whole needs.

# Postgres connection string (same database used by the n8n workflows' "Postgres account" credential).
DATABASE_URL=postgresql://user:password@host:5432/database

# API key for the AI provider used by the AI Sales Assistant workflows in n8n.
# Currently the n8n workflows use the existing "Google Gemini(PaLM) Api account" n8n credential directly,
# so this is only needed if you later call the AI API directly from the dashboard or another script.
AI_API_KEY=

# Base URL of your n8n instance (no trailing slash). Used by the dashboard to call:
#   POST {N8N_WEBHOOK_URL}/webhook/sales/leads-intake
#   POST {N8N_WEBHOOK_URL}/webhook/sales/messages/generate
#   POST {N8N_WEBHOOK_URL}/webhook/sales/messages/approve
#   POST {N8N_WEBHOOK_URL}/webhook/sales/demo/book
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com

# API key for your messaging provider (WhatsApp Business Cloud API), if you rotate/manage it outside
# of the n8n "WhatsApp account" credential. Not read directly by any code in this repo today —
# the n8n WhatsApp node uses its own stored credential — kept here as the designated place to add it
# if the messaging abstraction later needs a directly-held key (e.g. a different provider).
MESSAGE_PROVIDER_API_KEY=

# Public URL customers land on when you send them a demo. Used as a fallback by "Sales - Demo Booking"
# when no lead-specific/settings demo_booking_url is configured (see settings table, key demo_booking_url).
DEMO_BOOKING_URL=

# انسخ هذا الملف إلى .env وعبّي القيم قبل التشغيل:
#   cp .env.example .env

# سر التوقيع — يحمي كوكي الجلسة اللي تثبت إن الشخص فعلًا سجّل بإيميله.
# لازم يكون طويل وعشوائي. ولّده بأمر: openssl rand -hex 32
APP_SECRET=

# اختياري — مسار ملف قاعدة بيانات SQLite (افتراضيًا ./data/app.db)
# DB_PATH=./data/app.db

# اختياري — مسار ملف الهدية على القرص (افتراضيًا ./private-gift/gift.html)
# GIFT_FILE_PATH=./private-gift/gift.html

# اختياري — الاسم اللي يظهر للمستخدم عند التحميل
# GIFT_FILE_NAME=خريطة-كلود.html

# اختياري — إذا الهدية رابط خارجي (Drive، خريطة أونلاين، إلخ) بدل ملف محلي،
# عيّن هذا وتجاهل متغيرات GIFT_FILE_* فوق.
# GIFT_EXTERNAL_URL=

# اختياري — رابط Google Apps Script Web App لمزامنة الإيميلات مع Google Sheet
# (اتركه فاضي لتعطيل المزامنة). راجع قسم "مزامنة الإيميلات مع Google Sheets"
# في README.md للخطوات.
# GOOGLE_SHEETS_WEBHOOK_URL=

# اختياري — كلمة مرور لوحة /admin اللي تعرض الإيميلات المسجلة من داخل الموقع
# نفسه (بدون Google). بدون هذا المتغير، الصفحة معطّلة تلقائيًا.
# ADMIN_PASSWORD=

# انسخ هذا الملف إلى .env وعبّي القيم قبل التشغيل:
#   cp .env.example .env

# سر التوقيع — يحمي كوكي الجلسة ورابط الهدية الموقّع. لازم يكون طويل وعشوائي.
# ولّده بأمر: openssl rand -hex 32
APP_SECRET=

# اختياري — مسار ملف قاعدة بيانات SQLite (افتراضيًا ./data/app.db)
# DB_PATH=./data/app.db

# اختياري — مسار ملف الهدية على القرص (افتراضيًا ./private-gift/gift.pdf)
# GIFT_FILE_PATH=./private-gift/gift.pdf

# اختياري — الاسم اللي يظهر للمستخدم عند التحميل
# GIFT_FILE_NAME=الهدية.pdf

# اختياري — إذا الهدية رابط خارجي (Drive، خريطة أونلاين، إلخ) بدل ملف محلي،
# عيّن هذا وتجاهل متغيرات GIFT_FILE_* فوق. لما يكون معبّى، الرابط يفتح مباشرة
# بدون تمرير عبر الخادم.
# GIFT_EXTERNAL_URL=
